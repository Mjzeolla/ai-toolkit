{
  "name": "MZeolla",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace and validation toolkit for portable AI coding-agent plugins.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm markdown:check && pnpm format:check && pnpm typecheck && pnpm test && pnpm validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test",
    "markdown:check": "markdownlint-cli2",
    "markdown:fix": "markdownlint-cli2 --fix",
    "prepare": "husky",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/validate-catalog.ts"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1"
  }
}
