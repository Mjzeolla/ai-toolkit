#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
mode="link"
destinations=()

usage() {
  cat <<'EOF'
Usage: scripts/dev/link-skills [OPTIONS]

Link every catalog skill into one or more agent discovery directories.

Options:
  --all                 Link to ~/.agents/skills and ~/.claude/skills (default).
  --agent agents        Link to the Agent Skills-compatible directory.
  --agent codex         Alias for the Agent Skills-compatible directory.
  --agent claude        Link to the Claude Code directory.
  --target DIRECTORY    Link to a custom directory; may be repeated.
  --unlink              Remove only links owned by this repository.
  --help                Show this help text.

If any --agent or --target option is provided, only those destinations are used.
EOF
}

add_destination() {
  local candidate="$1"
  local existing

  for existing in "${destinations[@]-}"; do
    [[ "$existing" == "$candidate" ]] && return
  done
  destinations+=("$candidate")
}

add_agent_destination() {
  case "$1" in
    agents|codex)
      add_destination "${AGENTS_HOME:-$HOME/.agents}/skills"
      ;;
    claude)
      add_destination "${CLAUDE_HOME:-$HOME/.claude}/skills"
      ;;
    *)
      echo "ERROR: unsupported agent target: $1" >&2
      echo "Supported targets: agents, codex, claude" >&2
      exit 2
      ;;
  esac
}

while (($# > 0)); do
  case "$1" in
    --all)
      add_agent_destination agents
      add_agent_destination claude
      shift
      ;;
    --agent)
      [[ $# -ge 2 ]] || { echo "ERROR: --agent requires a name" >&2; exit 2; }
      add_agent_destination "$2"
      shift 2
      ;;
    --target)
      [[ $# -ge 2 ]] || { echo "ERROR: --target requires a directory" >&2; exit 2; }
      add_destination "$2"
      shift 2
      ;;
    --unlink)
      mode="unlink"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ((${#destinations[@]} == 0)); then
  add_agent_destination agents
  add_agent_destination claude
fi

for destination_root in "${destinations[@]}"; do
  if [[ -L "$destination_root" ]]; then
    resolved_destination="$(cd "$destination_root" 2>/dev/null && pwd -P)" || {
      echo "ERROR: destination symlink cannot be resolved: $destination_root" >&2
      exit 1
    }
    case "$resolved_destination" in
      "$repository_root"|"$repository_root"/*)
        echo "ERROR: destination resolves inside this repository: $destination_root" >&2
        exit 1
        ;;
    esac
  fi

  mkdir -p "$destination_root"

  while IFS= read -r skill_file; do
    source_directory="$(dirname "$skill_file")"
    skill_name="$(basename "$source_directory")"
    destination="$destination_root/$skill_name"

    if [[ "$mode" == "unlink" ]]; then
      if [[ -L "$destination" && "$(readlink "$destination")" == "$source_directory" ]]; then
        rm "$destination"
        echo "Unlinked $skill_name from $destination_root"
      fi
      continue
    fi

    if [[ -e "$destination" || -L "$destination" ]]; then
      if [[ -L "$destination" && "$(readlink "$destination")" == "$source_directory" ]]; then
        echo "Already linked: $skill_name in $destination_root"
        continue
      fi
      echo "ERROR: refusing to replace existing destination: $destination" >&2
      exit 1
    fi

    ln -s "$source_directory" "$destination"
    echo "Linked $skill_name -> $destination"
  done < <(find "$repository_root/skills" -mindepth 3 -maxdepth 3 -name SKILL.md -print | sort)
done
