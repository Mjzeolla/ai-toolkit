#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repository_root"
mode="online"

if [[ "${1:-}" == "--offline" ]]; then
  mode="offline"
  shift
fi

if (($# > 0)); then
  echo "ERROR: unknown argument: $1" >&2
  echo "Usage: scripts/ci/check-links [--offline]" >&2
  exit 2
fi

arguments=(
  --config lychee.toml
  --no-progress
  --root-dir "$repository_root"
)

if [[ "$mode" == "offline" ]]; then
  arguments+=(--offline)
fi

mise exec -- lychee "${arguments[@]}" '**/*.md'
